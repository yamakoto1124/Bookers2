<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0">
      <h2>Log in</h2>

      <%= form_with url: session_path, local: true do |f| %>
        <div class="form-group mb-3">
          <%= f.label :name, "Name", class: "form-label" %>
          <%= f.text_field :name, class: "form-control", autocomplete: "name" %>
        </div>

        <div class="form-group mb-3">
          <%= f.label :password, "Password", class: "form-label" %>
          <%= f.password_field :password, class: "form-control", autocomplete: "current-password" %>
        </div>

        <div class="form-group form-check mb-3">
          <%= f.check_box :remember_me, class: "form-check-input" %>
          <%= f.label :remember_me, "Remember me", class: "form-check-label" %>
        </div>

        <div class="form-group">
          <%= f.submit "Log in", class: "btn btn-sm btn-primary" %>
        </div>
      <% end %>

      <div class="mt-3">
        <%= link_to "Sign up", new_user_path %><br>
        <%= link_to "Forgot your password?", "#" %>
      </div>
    </div>
  </div>
</div>
