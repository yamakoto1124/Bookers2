<div class="container px-5 px-sm-0">
  <div class="row">
    <!-- 左側サイドバー（ユーザー情報 ＆ 新規投稿フォーム） -->
    <div class="col-md-3">
     <%= render 'users/info', user: @user %>
     <%= render 'books/form', book: @book %>
    </div>

    <!-- 右側: 本の詳細 -->
    <div class="col-md-8 offset-md-1">
      <h2>Book detail</h2>
      <table class="table">
        <tbody>
          <tr>
            <td>
              <%= link_to user_path(@book.user) do %>
                <%= image_tag @book.user.get_profile_image(100, 100) if @book.user.respond_to?(:get_profile_image) %><br>
                <%= @book.user.name %>
              <% end %>
            </td>
            <td><%= link_to @book.title, book_path(@book) %></td>
            <td><%= @book.body %></td>

            <!-- ログイン中の本人の投稿の場合のみ編集・削除ボタンを表示 -->
            <% if @book.user_id == Current.user.id %>
              <td><%= link_to "Edit", edit_book_path(@book), class: "btn btn-sm btn-success" %></td>
              <td><%= link_to "Destroy", book_path(@book), class: "btn btn-sm btn-danger", data: { turbo_method: :delete, turbo_confirm: "本当に消しますか？" } %></td>
            <% end %>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>